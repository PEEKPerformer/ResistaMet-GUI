{
  "definitions": {
    "AuxSensorSettings": {
      "additionalProperties": true,
      "description": "Auxiliary-sensor co-logging. Serialized inside ``measurement``.\n\nCo-logging is only wired into the continuous modes\n(``data_export.AUX_LOG_MODES``); the resolver reports an issue when a\nrequest asks for it on a sweep or vdP run.",
      "properties": {
        "aux_address": {
          "default": "ASRL6::INSTR",
          "minLength": 1,
          "title": "Aux Address",
          "type": "string"
        },
        "aux_driver": {
          "default": "arduino_thermocouple",
          "minLength": 1,
          "title": "Aux Driver",
          "type": "string"
        },
        "aux_log_enabled": {
          "default": false,
          "title": "Aux Log Enabled",
          "type": "boolean"
        }
      },
      "title": "AuxSensorSettings",
      "type": "object"
    },
    "CurrentSourceSettings": {
      "additionalProperties": true,
      "description": "Source I, measure V. ``isource_duration_hours`` of 0 runs until stopped.",
      "properties": {
        "isource_current": {
          "default": 0.001,
          "maximum": 3.0,
          "minimum": -3.0,
          "title": "Isource Current",
          "type": "number"
        },
        "isource_duration_hours": {
          "default": 0.0,
          "maximum": 168.0,
          "minimum": 0.0,
          "title": "Isource Duration Hours",
          "type": "number"
        },
        "isource_voltage_compliance": {
          "default": 5.0,
          "maximum": 200.0,
          "minimum": 0.1,
          "title": "Isource Voltage Compliance",
          "type": "number"
        },
        "isource_voltage_range_auto": {
          "default": true,
          "title": "Isource Voltage Range Auto",
          "type": "boolean"
        }
      },
      "title": "CurrentSourceSettings",
      "type": "object"
    },
    "DisplaySettings": {
      "additionalProperties": true,
      "description": "Plot appearance. Frontend-only, modelled so a profile round-trips.",
      "properties": {
        "buffer_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Buffer Size"
        },
        "enable_plot": {
          "default": true,
          "title": "Enable Plot",
          "type": "boolean"
        },
        "plot_color_i": {
          "default": "#009E73",
          "title": "Plot Color I",
          "type": "string"
        },
        "plot_color_r": {
          "default": "#D55E00",
          "title": "Plot Color R",
          "type": "string"
        },
        "plot_color_v": {
          "default": "#0072B2",
          "title": "Plot Color V",
          "type": "string"
        },
        "plot_figsize": {
          "items": {
            "type": "number"
          },
          "title": "Plot Figsize",
          "type": "array"
        },
        "plot_update_interval": {
          "default": 16,
          "maximum": 10000,
          "minimum": 1,
          "title": "Plot Update Interval",
          "type": "integer"
        }
      },
      "title": "DisplaySettings",
      "type": "object"
    },
    "FileSettings": {
      "additionalProperties": true,
      "description": "Where rows are written and how often they are flushed.",
      "properties": {
        "auto_save_interval": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Auto Save Interval",
          "type": "integer"
        },
        "data_directory": {
          "default": "measurement_data",
          "minLength": 1,
          "title": "Data Directory",
          "type": "string"
        }
      },
      "title": "FileSettings",
      "type": "object"
    },
    "FourPointSettings": {
      "additionalProperties": true,
      "description": "Four-point probe, with the ASTM F84 correction-factor inputs.\n\n``fpp_temperature_c`` is ``None`` when the temperature was not measured.\nThe UI carries that as a -50 C sentinel on its spin box (the widget's\n\"not measured\" special value) and the worker as NaN; the resolver converts\nbetween the two, and neither representation reaches this model.",
      "properties": {
        "fpp_alpha": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Fpp Alpha",
          "type": "number"
        },
        "fpp_array_angle_deg": {
          "default": 0.0,
          "maximum": 360.0,
          "minimum": -360.0,
          "title": "Fpp Array Angle Deg",
          "type": "number"
        },
        "fpp_current": {
          "default": 0.0001,
          "maximum": 3.0,
          "minimum": -3.0,
          "title": "Fpp Current",
          "type": "number"
        },
        "fpp_delta_mode": {
          "default": false,
          "title": "Fpp Delta Mode",
          "type": "boolean"
        },
        "fpp_delta_settling": {
          "default": 0.1,
          "maximum": 5.0,
          "minimum": 0.01,
          "title": "Fpp Delta Settling",
          "type": "number"
        },
        "fpp_diameter_cm": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Fpp Diameter Cm",
          "type": "number"
        },
        "fpp_dopant_type": {
          "default": "none",
          "enum": [
            "none",
            "n",
            "p"
          ],
          "title": "Fpp Dopant Type",
          "type": "string"
        },
        "fpp_edge_warn_pct": {
          "default": 1.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Fpp Edge Warn Pct",
          "type": "number"
        },
        "fpp_geometry": {
          "default": "circle",
          "enum": [
            "circle",
            "square",
            "rectangle_2",
            "rectangle_3",
            "rectangle_4"
          ],
          "title": "Fpp Geometry",
          "type": "string"
        },
        "fpp_k_factor": {
          "default": 4.532,
          "maximum": 50.0,
          "minimum": 0.1,
          "title": "Fpp K Factor",
          "type": "number"
        },
        "fpp_model": {
          "default": "thin_film",
          "enum": [
            "thin_film",
            "semi_infinite",
            "finite_thin",
            "finite_alpha"
          ],
          "title": "Fpp Model",
          "type": "string"
        },
        "fpp_position_correction": {
          "const": "warn",
          "default": "warn",
          "title": "Fpp Position Correction",
          "type": "string"
        },
        "fpp_power_stop_w": {
          "default": 0.1,
          "maximum": 22.0,
          "minimum": 0.0001,
          "title": "Fpp Power Stop W",
          "type": "number"
        },
        "fpp_power_warn_w": {
          "default": 0.01,
          "maximum": 10.0,
          "minimum": 0.0001,
          "title": "Fpp Power Warn W",
          "type": "number"
        },
        "fpp_sample_diameter_mm": {
          "default": 0.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fpp Sample Diameter Mm",
          "type": "number"
        },
        "fpp_sample_length_mm": {
          "default": 0.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fpp Sample Length Mm",
          "type": "number"
        },
        "fpp_sample_shape": {
          "default": "unbounded",
          "enum": [
            "unbounded",
            "circle",
            "rectangle"
          ],
          "title": "Fpp Sample Shape",
          "type": "string"
        },
        "fpp_sample_width_mm": {
          "default": 0.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fpp Sample Width Mm",
          "type": "number"
        },
        "fpp_samples": {
          "default": 20,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Fpp Samples",
          "type": "integer"
        },
        "fpp_spacing_cm": {
          "default": 0.1016,
          "maximum": 5.0,
          "minimum": 0.001,
          "title": "Fpp Spacing Cm",
          "type": "number"
        },
        "fpp_stop_on_overpower": {
          "default": true,
          "title": "Fpp Stop On Overpower",
          "type": "boolean"
        },
        "fpp_temperature_c": {
          "anyOf": [
            {
              "maximum": 200.0,
              "minimum": -50.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fpp Temperature C"
        },
        "fpp_thickness_um": {
          "default": 0.0,
          "maximum": 5000.0,
          "minimum": 0.0,
          "title": "Fpp Thickness Um",
          "type": "number"
        },
        "fpp_voltage_compliance": {
          "default": 5.0,
          "maximum": 200.0,
          "minimum": 0.1,
          "title": "Fpp Voltage Compliance",
          "type": "number"
        },
        "fpp_voltage_range_auto": {
          "default": true,
          "title": "Fpp Voltage Range Auto",
          "type": "boolean"
        }
      },
      "title": "FourPointSettings",
      "type": "object"
    },
    "InstrumentSettings": {
      "additionalProperties": true,
      "description": "Knobs that apply to every mode, wherever the value comes from.\n\n``gpib_address``, ``visa_library`` and ``gpib_interface`` are machine-local\n\u2014 ``ConfigManager`` keeps them under ``machines[hostname]`` and injects\nthem into the profile on read, so they are never stored per user\n(``config.py``).",
      "properties": {
        "auto_zero": {
          "default": "once",
          "enum": [
            "on",
            "once",
            "off"
          ],
          "title": "Auto Zero",
          "type": "string"
        },
        "filter_count": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Filter Count",
          "type": "integer"
        },
        "filter_enabled": {
          "default": true,
          "title": "Filter Enabled",
          "type": "boolean"
        },
        "filter_type": {
          "default": "repeat",
          "enum": [
            "repeat",
            "moving"
          ],
          "title": "Filter Type",
          "type": "string"
        },
        "gpib_address": {
          "default": "GPIB0::24::INSTR",
          "minLength": 1,
          "title": "Gpib Address",
          "type": "string"
        },
        "gpib_interface": {
          "default": "",
          "description": "Interface resource of a Prologix-style GPIB adapter (Prologix GPIB-USB / GPIB-ETHERNET, AR488), opened before the instrument so that GPIB<board>::<addr>::INSTR resolves; pyvisa-py only. Empty = none. Serial: PRLGX-ASRL[board]::<device>::INTFC, where <device> is the port path on macOS and Linux (PRLGX-ASRL::/dev/cu.usbserial-PX12345::INTFC, PRLGX-ASRL::/dev/ttyUSB0::INTFC) and the COM port number alone on Windows (PRLGX-ASRL::5::INTFC for COM5). Ethernet: PRLGX-TCPIP[board]::<host>[::port]::INTFC, port 1234 by default. [board] defaults to 0 and is the <board> of the instrument address.",
          "title": "Gpib Interface",
          "type": "string"
        },
        "nplc": {
          "default": 1,
          "maximum": 10.0,
          "minimum": 0.01,
          "title": "Nplc",
          "type": "number"
        },
        "sampling_rate": {
          "default": 10.0,
          "maximum": 100.0,
          "minimum": 0.1,
          "title": "Sampling Rate",
          "type": "number"
        },
        "settling_time": {
          "default": 0.2,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Settling Time",
          "type": "number"
        },
        "stop_on_compliance": {
          "default": false,
          "title": "Stop On Compliance",
          "type": "boolean"
        },
        "visa_library": {
          "default": "",
          "title": "Visa Library",
          "type": "string"
        }
      },
      "title": "InstrumentSettings",
      "type": "object"
    },
    "OutputSettings": {
      "additionalProperties": true,
      "description": "Exporter selection; consumed by ``data_export.make_exporter``.",
      "properties": {
        "compression": {
          "default": "never",
          "enum": [
            "never",
            "always",
            "auto"
          ],
          "title": "Compression",
          "type": "string"
        },
        "compression_threshold_mb": {
          "default": 5,
          "minimum": 0.0,
          "title": "Compression Threshold Mb",
          "type": "number"
        },
        "format": {
          "default": "csv",
          "enum": [
            "csv",
            "hdf5",
            "csv+legacy_json"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "title": "OutputSettings",
      "type": "object"
    },
    "ResistanceSettings": {
      "additionalProperties": true,
      "description": "Source I, measure R. 2-wire or 4-wire, optional cable null.",
      "properties": {
        "res_auto_range": {
          "default": true,
          "title": "Res Auto Range",
          "type": "boolean"
        },
        "res_cable_null": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Res Cable Null",
          "type": "number"
        },
        "res_measurement_type": {
          "default": "2-wire",
          "enum": [
            "2-wire",
            "4-wire"
          ],
          "title": "Res Measurement Type",
          "type": "string"
        },
        "res_offset_comp": {
          "default": true,
          "title": "Res Offset Comp",
          "type": "boolean"
        },
        "res_test_current": {
          "default": 0.001,
          "maximum": 3.0,
          "minimum": 1e-07,
          "title": "Res Test Current",
          "type": "number"
        },
        "res_voltage_compliance": {
          "default": 5.0,
          "maximum": 200.0,
          "minimum": 0.1,
          "title": "Res Voltage Compliance",
          "type": "number"
        }
      },
      "title": "ResistanceSettings",
      "type": "object"
    },
    "RunRequest": {
      "$defs": {
        "ClientInfo": {
          "additionalProperties": false,
          "description": "Which program asked for the run, recorded in the file header.\n\nThe backend's own version is always written (``software_version``); this\nsays what was driving it -- the desktop app, a script, the MCP layer --\nso a file written through the API can be told from one the PySide6 app\nwrote. Self-reported, so it is provenance and not authentication.",
          "properties": {
            "name": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}$",
              "title": "Name",
              "type": "string"
            },
            "version": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}$",
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "title": "ClientInfo",
          "type": "object"
        },
        "SpotRequest": {
          "additionalProperties": false,
          "description": "One placement of the probe, as the client describes it.\n\nThe position is optional -- a spot can be a label and nothing more -- but\n``x_mm`` and ``y_mm`` only mean something together. ``angle_deg`` is the\ndirection of the probe array, anticlockwise from +x; absent, the run uses\nthe ``fpp_array_angle_deg`` setting.",
          "properties": {
            "angle_deg": {
              "anyOf": [
                {
                  "maximum": 360.0,
                  "minimum": -360.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Angle Deg"
            },
            "index": {
              "maximum": 9999,
              "minimum": 0,
              "title": "Index",
              "type": "integer"
            },
            "label": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "title": "Label",
              "type": "string"
            },
            "map_id": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Map Id",
              "type": "string"
            },
            "x_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "X Mm"
            },
            "y_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Y Mm"
            }
          },
          "required": [
            "map_id",
            "index",
            "label"
          ],
          "title": "SpotRequest",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "What a client asks for. Never persisted.\n\n``overrides`` is flat measurement keys, the same shape the tabs produce\ntoday, so one request format serves the UI, a script and the MCP layer.\nStrict validation of the keys happens in the resolver, which knows which\nones the profile owns.",
      "properties": {
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "enum": [
            "resistance",
            "source_v",
            "source_i",
            "four_point",
            "sweep",
            "vdp"
          ],
          "title": "Mode",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": true,
          "title": "Overrides",
          "type": "object"
        },
        "prompt_timeout_s": {
          "default": 900.0,
          "exclusiveMinimum": 0.0,
          "title": "Prompt Timeout S",
          "type": "number"
        },
        "sample_name": {
          "minLength": 1,
          "title": "Sample Name",
          "type": "string"
        },
        "spot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpotRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "username": {
          "minLength": 1,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "username",
        "sample_name"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "SafetySettings": {
      "additionalProperties": true,
      "description": "Touch-safety warning threshold. Serialized inside ``measurement``.\n\n``safety_voltage_warn_silenced`` is the sticky per-profile flag behind the\nwarning dialog's \"don't show again\" checkbox.\n\nThe threshold runs to 1100 V, the 2410's range and the Settings dialog's\nmaximum: a threshold the dialog can save must not make the profile\nunrunnable here. 0 disables the warning. Both keys belong to the profile;\na strict run request may not send either (``resolve.SAFETY_KEYS``).",
      "properties": {
        "safety_voltage_warn_silenced": {
          "default": false,
          "title": "Safety Voltage Warn Silenced",
          "type": "boolean"
        },
        "safety_voltage_warn_v": {
          "default": 30.0,
          "maximum": 1100.0,
          "minimum": 0.0,
          "title": "Safety Voltage Warn V",
          "type": "number"
        }
      },
      "title": "SafetySettings",
      "type": "object"
    },
    "SampleGeometry": {
      "additionalProperties": false,
      "description": "The lateral outline of a thin sample with insulating edges.\n\n``unbounded`` means a sheet large enough that its edges do not matter,\nwhich is what the software assumed before it knew about outlines.",
      "properties": {
        "diameter_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diameter Mm"
        },
        "length_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Mm"
        },
        "shape": {
          "default": "unbounded",
          "enum": [
            "unbounded",
            "circle",
            "rectangle"
          ],
          "title": "Shape",
          "type": "string"
        },
        "width_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        }
      },
      "title": "SampleGeometry",
      "type": "object"
    },
    "SpotRequest": {
      "additionalProperties": false,
      "description": "One placement of the probe, as the client describes it.\n\nThe position is optional -- a spot can be a label and nothing more -- but\n``x_mm`` and ``y_mm`` only mean something together. ``angle_deg`` is the\ndirection of the probe array, anticlockwise from +x; absent, the run uses\nthe ``fpp_array_angle_deg`` setting.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "maximum": 360.0,
              "minimum": -360.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "index": {
          "maximum": 9999,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Label",
          "type": "string"
        },
        "map_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Map Id",
          "type": "string"
        },
        "x_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Mm"
        },
        "y_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Mm"
        }
      },
      "required": [
        "map_id",
        "index",
        "label"
      ],
      "title": "SpotRequest",
      "type": "object"
    },
    "SweepSettings": {
      "additionalProperties": true,
      "description": "Bulk linear sweep, run by the instrument's own sweep engine.\n\nStart/stop keep the +/-200 V bounds for both source types, as the widgets\ndo today; source-aware bounds for them are a follow-up.",
      "properties": {
        "sweep_compliance": {
          "default": 0.1,
          "maximum": 210.0,
          "minimum": 1e-07,
          "title": "Sweep Compliance",
          "type": "number"
        },
        "sweep_delay": {
          "default": 0.01,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Sweep Delay",
          "type": "number"
        },
        "sweep_direction": {
          "default": "up",
          "enum": [
            "up",
            "down",
            "up_down"
          ],
          "title": "Sweep Direction",
          "type": "string"
        },
        "sweep_source": {
          "default": "voltage",
          "enum": [
            "voltage",
            "current"
          ],
          "title": "Sweep Source",
          "type": "string"
        },
        "sweep_start": {
          "default": 0.0,
          "maximum": 200.0,
          "minimum": -200.0,
          "title": "Sweep Start",
          "type": "number"
        },
        "sweep_step": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "title": "Sweep Step",
          "type": "number"
        },
        "sweep_stop": {
          "default": 1.0,
