          "type": "string"
        },
        "idn": {
          "title": "Idn",
          "type": "string"
        },
        "max_power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Power W"
        },
        "max_source_i": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source I"
        },
        "max_source_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source V"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "address",
        "idn",
        "model"
      ],
      "title": "InstrumentConnectedPayload",
      "type": "object"
    },
    "line_frequency": {
      "additionalProperties": false,
      "description": "Mains frequency, queried or assumed. Continuous modes only.",
      "properties": {
        "assumed": {
          "default": false,
          "title": "Assumed",
          "type": "boolean"
        },
        "hz": {
          "title": "Hz",
          "type": "number"
        }
      },
      "required": [
        "hz"
      ],
      "title": "LineFrequencyPayload",
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "description": "Human-readable progress, one per current ``status_update`` site.\n\n``code`` is a short closed set so a client can act on an event without\nparsing prose; ``message`` stays the exact text the GUI shows today.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "LogPayload",
      "type": "object"
    },
    "overpower_trip": {
      "additionalProperties": false,
      "description": "Measured V*I crossed the 4PP probe-safety hard stop.",
      "properties": {
        "measured_w": {
          "title": "Measured W",
          "type": "number"
        },
        "stop_w": {
          "title": "Stop W",
          "type": "number"
        }
      },
      "required": [
        "measured_w",
        "stop_w"
      ],
      "title": "OverpowerPayload",
      "type": "object"
    },
    "paused": {
      "additionalProperties": false,
      "description": "Paused, resumed or stopping, as observed by the acquisition thread.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "RunStatePayload",
      "type": "object"
    },
    "prompt": {
      "additionalProperties": false,
      "description": "The run is blocked until someone answers.",
      "properties": {
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "kind": {
          "enum": [
            "vdp_geometry",
            "safety_voltage_ack",
            "cable_null_shorted"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "requires_human": {
          "default": true,
          "title": "Requires Human",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "kind"
      ],
      "title": "PromptPayload",
      "type": "object"
    },
    "prompt_resolved": {
      "additionalProperties": false,
      "description": "How a prompt ended: answered, or released by a stop.",
      "properties": {
        "answered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered By"
        },
        "choice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        }
      },
      "required": [
        "prompt_id"
      ],
      "title": "PromptResolvedPayload",
      "type": "object"
    },
    "resumed": {
      "additionalProperties": false,
      "description": "Paused, resumed or stopping, as observed by the acquisition thread.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "RunStatePayload",
      "type": "object"
    },
    "run_ended": {
      "additionalProperties": false,
      "description": "Always the last event of a run, whatever ended it.\n\n``output_verified`` is False when the cleanup could not confirm the\ninstrument output is off: its ``:OUTP OFF`` raised, or ``:OUTP?`` did not\nread back 0. The source may still be driving the sample; a ``log`` with\ncode ``output_unverified`` says so before this event.",
      "properties": {
        "duration_s": {
          "default": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "output_verified": {
          "default": true,
          "title": "Output Verified",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "samples": {
          "default": 0,
          "title": "Samples",
          "type": "integer"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RunEndedPayload",
      "type": "object"
    },
    "run_started": {
      "additionalProperties": false,
      "description": "A run is beginning; the settings are exactly what it will use.",
      "properties": {
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "sample_name": {
          "title": "Sample Name",
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "sample_name",
        "username",
        "started_at"
      ],
      "title": "RunStartedPayload",
      "type": "object"
    },
    "sample": {
      "$defs": {
        "DeltaPayload": {
          "additionalProperties": false,
          "description": "Per-polarity values from a current-reversal (delta) reading.",
          "properties": {
            "r_f": {
              "title": "R F",
              "type": "number"
            },
            "r_r": {
              "title": "R R",
              "type": "number"
            },
            "v_minus": {
              "title": "V Minus",
              "type": "number"
            },
            "v_plus": {
              "title": "V Plus",
              "type": "number"
            }
          },
          "required": [
            "v_plus",
            "v_minus",
            "r_f",
            "r_r"
          ],
          "title": "DeltaPayload",
          "type": "object"
        },
        "DerivedPayload": {
          "additionalProperties": false,
          "description": "The 4PP quantities computed for this sample, as written to the row.\n\n``method`` says which correction path produced them: the ASTM F84\ndecomposition or the legacy K*alpha form.",
          "properties": {
            "i_unc": {
              "title": "I Unc",
              "type": "number"
            },
            "method": {
              "enum": [
                "f84",
                "legacy"
              ],
              "title": "Method",
              "type": "string"
            },
            "ratio": {
              "title": "Ratio",
              "type": "number"
            },
            "rho": {
              "title": "Rho",
              "type": "number"
            },
            "rs": {
              "title": "Rs",
              "type": "number"
            },
            "sigma": {
              "title": "Sigma",
              "type": "number"
            },
            "v_unc": {
              "title": "V Unc",
              "type": "number"
            }
          },
          "required": [
            "ratio",
            "rs",
            "rho",
            "sigma",
            "v_unc",
            "i_unc",
            "method"
          ],
          "title": "DerivedPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One acquired point.\n\n``values`` is the mode's data dict exactly as the parse produced it, with\nno coercion \u2014 the aux-fault column is a string, and a client that wants\nnumbers must say which key it means.",
      "properties": {
        "compliance": {
          "default": "OK",
          "enum": [
            "OK",
            "V_COMP",
            "I_COMP"
          ],
          "title": "Compliance",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeltaPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivedPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elapsed_s": {
          "title": "Elapsed S",
          "type": "number"
        },
        "event_marker": {
          "default": "",
          "title": "Event Marker",
          "type": "string"
        },
        "t_unix": {
          "title": "T Unix",
          "type": "number"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "t_unix",
        "elapsed_s"
      ],
      "title": "SamplePayload",
      "type": "object"
    },
    "spot_complete": {
      "$defs": {
        "QuantityStats": {
          "additionalProperties": false,
          "description": "One derived quantity over a spot's samples (``session.spot_stats``).\n\n``n`` counts the finite values. Every other field is null on the wire when\nit does not exist: all of them with no finite value, ``sd`` and\n``rsd_pct`` with fewer than two.",
          "properties": {
            "mean": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mean"
            },
            "n": {
              "title": "N",
              "type": "integer"
            },
            "rsd_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rsd Pct"
            },
            "sd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Sd"
            },
            "u_inst": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Inst"
            },
            "u_stat": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Stat"
            },
            "u_total": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Total"
            }
          },
          "required": [
            "n"
          ],
          "title": "QuantityStats",
          "type": "object"
        },
        "SpotRequest": {
          "additionalProperties": false,
          "description": "One placement of the probe, as the client describes it.\n\nThe position is optional -- a spot can be a label and nothing more -- but\n``x_mm`` and ``y_mm`` only mean something together. ``angle_deg`` is the\ndirection of the probe array, anticlockwise from +x; absent, the run uses\nthe ``fpp_array_angle_deg`` setting.",
          "properties": {
            "angle_deg": {
              "anyOf": [
                {
                  "maximum": 360.0,
                  "minimum": -360.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Angle Deg"
            },
            "index": {
              "maximum": 9999,
              "minimum": 0,
              "title": "Index",
              "type": "integer"
            },
            "label": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "title": "Label",
              "type": "string"
            },
            "map_id": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Map Id",
              "type": "string"
            },
            "x_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
