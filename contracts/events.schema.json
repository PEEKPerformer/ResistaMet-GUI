{
  "envelope": {
    "additionalProperties": false,
    "description": "One thing that happened during a run.",
    "properties": {
      "cursor": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Run Id"
      },
      "seq": {
        "minimum": 0,
        "title": "Seq",
        "type": "integer"
      },
      "t": {
        "title": "T",
        "type": "number"
      },
      "type": {
        "title": "Type",
        "type": "string"
      },
      "v": {
        "default": 1,
        "title": "V",
        "type": "integer"
      }
    },
    "required": [
      "type",
      "seq",
      "t"
    ],
    "title": "Event",
    "type": "object"
  },
  "payloads": {
    "acquisition_finished": {
      "additionalProperties": false,
      "description": "The acquisition loop ended; cleanup and finalize still follow.",
      "properties": {
        "mode": {
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "AcquisitionFinishedPayload",
      "type": "object"
    },
    "aux_connected": {
      "additionalProperties": false,
      "description": "The auxiliary sensor is open and has declared its channels.",
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "channels": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Channels",
          "type": "array"
        },
        "driver": {
          "title": "Driver",
          "type": "string"
        }
      },
      "required": [
        "driver",
        "address"
      ],
      "title": "AuxConnectedPayload",
      "type": "object"
    },
    "compliance": {
      "additionalProperties": false,
      "description": "The source is in compliance on this sample.",
      "properties": {
        "kind": {
          "enum": [
            "Voltage",
            "Current"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stop_on_compliance": {
          "default": false,
          "title": "Stop On Compliance",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CompliancePayload",
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "description": "Something failed. ``source`` says which subsystem.\n\n``source`` replaces the substring matching the UI does today to decide\nwhether an error came from the instrument, the aux sensor or the file.\n``fatal`` marks the errors that end the run.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "fatal": {
          "default": true,
          "title": "Fatal",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source": {
          "enum": [
            "smu",
            "aux",
            "file",
            "run"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "code",
        "source",
        "message"
      ],
      "title": "ErrorPayload",
      "type": "object"
    },
    "file_finalized": {
      "additionalProperties": false,
      "description": "The run's file is closed, with its end metadata written.",
      "properties": {
        "end_metadata": {
          "additionalProperties": true,
          "title": "End Metadata",
          "type": "object"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileFinalizedPayload",
      "type": "object"
    },
    "file_opened": {
      "additionalProperties": false,
      "description": "The run's output file exists and its column schema is fixed.",
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileOpenedPayload",
      "type": "object"
    },
    "geometry_warning": {
      "$defs": {
        "SpotRequest": {
          "additionalProperties": false,
          "description": "One placement of the probe, as the client describes it.\n\nThe position is optional -- a spot can be a label and nothing more -- but\n``x_mm`` and ``y_mm`` only mean something together. ``angle_deg`` is the\ndirection of the probe array, anticlockwise from +x; absent, the run uses\nthe ``fpp_array_angle_deg`` setting.",
          "properties": {
            "angle_deg": {
              "anyOf": [
                {
                  "maximum": 360.0,
                  "minimum": -360.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Angle Deg"
            },
            "index": {
              "maximum": 9999,
              "minimum": 0,
              "title": "Index",
              "type": "integer"
            },
            "label": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "title": "Label",
              "type": "string"
            },
            "map_id": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Map Id",
              "type": "string"
            },
            "x_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "X Mm"
            },
            "y_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Y Mm"
            }
          },
          "required": [
            "map_id",
            "index",
            "label"
          ],
          "title": "SpotRequest",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "A four-point spot's position is a problem, said before the first sample.\n\n``refused`` with ``off_sample``: a probe tip is on or beyond the edge and\nthe run ends without touching the instrument. ``near_edge``: the position\ncosts more than ``edge_warn_pct`` here; the run goes on and the values are\nrecorded as measured, without a position correction.\n\nTwo errors, both fractions and not percentages. ``relative_error_rows`` is\n``factor_rows / factor_here - 1``, against the lateral factor the run's\nrows really apply (the table look-up, or K*alpha); it is the error in the\nfile's Rs. ``relative_error`` is ``factor_centre / factor_here - 1``,\nagainst the closed-form centre of the sample outline. ``compared_with``\nsays which one was held against the threshold: ``rows`` whenever the rows\nhave a factor, else ``centre``. The factors are absent off the sample,\nwhere they diverge.",
      "properties": {
        "compared_with": {
          "default": "centre",
          "enum": [
            "rows",
            "centre"
          ],
          "title": "Compared With",
          "type": "string"
        },
        "edge_clearance_s": {
          "title": "Edge Clearance S",
          "type": "number"
        },
        "edge_warn_pct": {
          "title": "Edge Warn Pct",
          "type": "number"
        },
        "factor_centre": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor Centre"
        },
        "factor_here": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor Here"
        },
        "factor_rows": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor Rows"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reason": {
          "enum": [
            "off_sample",
            "near_edge"
          ],
          "title": "Reason",
          "type": "string"
        },
        "refused": {
          "title": "Refused",
          "type": "boolean"
        },
        "relative_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Error"
        },
        "relative_error_rows": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Error Rows"
        },
        "spot": {
          "$ref": "#/$defs/SpotRequest"
        }
      },
      "required": [
        "refused",
        "reason",
        "message",
        "spot",
        "edge_clearance_s",
        "edge_warn_pct"
      ],
      "title": "GeometryWarningPayload",
      "type": "object"
    },
    "instrument_connected": {
      "additionalProperties": false,
      "description": "The SMU answered *IDN? and its limits are known.",
