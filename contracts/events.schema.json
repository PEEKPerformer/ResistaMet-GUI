{
  "envelope": {
    "additionalProperties": false,
    "description": "One thing that happened during a run.",
    "properties": {
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Run Id"
      },
      "seq": {
        "minimum": 0,
        "title": "Seq",
        "type": "integer"
      },
      "t": {
        "title": "T",
        "type": "number"
      },
      "type": {
        "title": "Type",
        "type": "string"
      },
      "v": {
        "default": 1,
        "title": "V",
        "type": "integer"
      }
    },
    "required": [
      "type",
      "seq",
      "t"
    ],
    "title": "Event",
    "type": "object"
  },
  "payloads": {
    "acquisition_finished": {
      "additionalProperties": false,
      "description": "The acquisition loop ended; cleanup and finalize still follow.",
      "properties": {
        "mode": {
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "AcquisitionFinishedPayload",
      "type": "object"
    },
    "compliance": {
      "additionalProperties": false,
      "description": "The source is in compliance on this sample.",
      "properties": {
        "kind": {
          "enum": [
            "Voltage",
            "Current"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stop_on_compliance": {
          "default": false,
          "title": "Stop On Compliance",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CompliancePayload",
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "description": "Something failed. ``source`` says which subsystem.\n\n``source`` replaces the substring matching the UI does today to decide\nwhether an error came from the instrument, the aux sensor or the file.\n``fatal`` marks the errors that end the run.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "fatal": {
          "default": true,
          "title": "Fatal",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source": {
          "enum": [
            "smu",
            "aux",
            "file",
            "run"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "code",
        "source",
        "message"
      ],
      "title": "ErrorPayload",
      "type": "object"
    },
    "instrument_connected": {
      "additionalProperties": false,
      "description": "The SMU answered *IDN? and its limits are known.",
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "idn": {
          "title": "Idn",
          "type": "string"
        },
        "max_power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Power W"
        },
        "max_source_i": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source I"
        },
        "max_source_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source V"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "address",
        "idn",
        "model"
      ],
      "title": "InstrumentConnectedPayload",
      "type": "object"
    },
    "line_frequency": {
      "additionalProperties": false,
      "description": "Mains frequency, queried or assumed. Continuous modes only.",
      "properties": {
        "assumed": {
          "default": false,
          "title": "Assumed",
          "type": "boolean"
        },
        "hz": {
          "title": "Hz",
          "type": "number"
        }
      },
      "required": [
        "hz"
      ],
      "title": "LineFrequencyPayload",
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "description": "Human-readable progress, one per current ``status_update`` site.\n\n``code`` is a short closed set so a client can act on an event without\nparsing prose; ``message`` stays the exact text the GUI shows today.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "LogPayload",
      "type": "object"
    },
    "overpower_trip": {
      "additionalProperties": false,
      "description": "Measured V*I crossed the 4PP probe-safety hard stop.",
      "properties": {
        "measured_w": {
          "title": "Measured W",
          "type": "number"
        },
        "stop_w": {
          "title": "Stop W",
          "type": "number"
        }
      },
      "required": [
        "measured_w",
        "stop_w"
      ],
      "title": "OverpowerPayload",
      "type": "object"
    },
    "sample": {
      "additionalProperties": false,
      "description": "One acquired point.\n\n``values`` is the mode's data dict exactly as the parse produced it, with\nno coercion \u2014 the aux-fault column is a string, and a client that wants\nnumbers must say which key it means.",
      "properties": {
        "compliance": {
          "default": "OK",
          "enum": [
            "OK",
            "V_COMP",
            "I_COMP"
          ],
          "title": "Compliance",
          "type": "string"
        },
        "elapsed_s": {
          "title": "Elapsed S",
          "type": "number"
        },
        "event_marker": {
          "default": "",
          "title": "Event Marker",
          "type": "string"
        },
        "t_unix": {
          "title": "T Unix",
          "type": "number"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "t_unix",
        "elapsed_s"
      ],
      "title": "SamplePayload",
      "type": "object"
    },
    "sweep_segment": {
      "additionalProperties": false,
      "description": "One completed sweep direction, returned by the instrument in bulk.",
      "properties": {
        "compliance": {
          "items": {
            "type": "string"
          },
          "title": "Compliance",
          "type": "array"
        },
        "currents": {
          "items": {
            "type": "number"
          },
          "title": "Currents",
          "type": "array"
        },
        "direction": {
          "default": "forward",
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "voltages": {
          "items": {
            "type": "number"
          },
          "title": "Voltages",
          "type": "array"
        }
      },
      "title": "SweepSegmentPayload",
      "type": "object"
    },
    "vdp_geometry_complete": {
      "additionalProperties": false,
      "description": "One F76 geometry measured: the +I and -I voltages at this wiring.",
      "properties": {
        "current_a": {
          "title": "Current A",
          "type": "number"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "label_neg": {
          "title": "Label Neg",
          "type": "string"
        },
        "label_pos": {
          "title": "Label Pos",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "v_neg": {
          "title": "V Neg",
          "type": "number"
        },
        "v_pos": {
          "title": "V Pos",
          "type": "number"
        }
      },
      "required": [
        "index",
        "name",
        "group",
        "label_pos",
        "v_pos",
        "label_neg",
        "v_neg",
        "current_a"
      ],
      "title": "VdpGeometryCompletePayload",
      "type": "object"
    },
    "vdp_result": {
      "additionalProperties": false,
      "description": "The finished van der Pauw result, ASTM F76.\n\nField for field what the GUI result panel has always received, including\nthe f(Q) homogeneity check and the combined uncertainties, so the panel\nreads the same numbers the CSV metadata carries.",
      "properties": {
        "asymmetry_pct": {
          "title": "Asymmetry Pct",
          "type": "number"
        },
        "current_a": {
          "title": "Current A",
          "type": "number"
        },
        "f_a": {
          "title": "F A",
          "type": "number"
        },
        "f_b": {
          "title": "F B",
          "type": "number"
        },
        "homogeneous": {
          "title": "Homogeneous",
          "type": "boolean"
        },
        "q_a": {
          "title": "Q A",
          "type": "number"
        },
        "q_b": {
          "title": "Q B",
          "type": "number"
        },
        "rho_a": {
          "title": "Rho A",
          "type": "number"
        },
        "rho_avg": {
          "title": "Rho Avg",
          "type": "number"
        },
        "rho_avg_uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rho Avg Uncertainty"
        },
        "rho_b": {
          "title": "Rho B",
          "type": "number"
        },
        "sheet_resistance": {
          "title": "Sheet Resistance",
          "type": "number"
        },
        "sheet_resistance_uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Resistance Uncertainty"
        },
        "thickness_cm": {
          "title": "Thickness Cm",
          "type": "number"
        },
        "voltages": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Voltages",
          "type": "object"
        }
      },
      "required": [
        "rho_a",
        "rho_b",
        "rho_avg",
        "sheet_resistance",
        "q_a",
        "q_b",
        "f_a",
        "f_b",
        "homogeneous",
        "asymmetry_pct",
        "current_a",
        "thickness_cm"
      ],
      "title": "VdpResultPayload",
      "type": "object"
    }
  },
  "version": 1
}
