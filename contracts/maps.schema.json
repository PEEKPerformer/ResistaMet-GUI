{
  "definitions": {
    "SpotMap": {
      "$defs": {
        "InterSpotStats": {
          "additionalProperties": false,
          "description": "The spread of one quantity between the spots of a map.\n\nOver the spots' means, each spot counting once. ``sd`` is the sample\nstandard deviation and needs two spots; ``rsd_pct`` is ``sd / |mean|``.",
          "properties": {
            "mean": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mean"
            },
            "n": {
              "title": "N",
              "type": "integer"
            },
            "rsd_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rsd Pct"
            },
            "sd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Sd"
            }
          },
          "required": [
            "n"
          ],
          "title": "InterSpotStats",
          "type": "object"
        },
        "MapImage": {
          "additionalProperties": false,
          "description": "The photograph kept beside a map's runs.\n\n``sha256`` and ``bytes`` are those of the file as it is on disk now.\n``registration`` is absent until a client has stored one, and when the\nstored one was fitted to a different image than the file holds.",
          "properties": {
            "bytes": {
              "title": "Bytes",
              "type": "integer"
            },
            "file": {
              "title": "File",
              "type": "string"
            },
            "registration": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MapImageRegistration"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "sha256": {
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "file",
            "sha256",
            "bytes"
          ],
          "title": "MapImage",
          "type": "object"
        },
        "MapImageRegistration": {
          "additionalProperties": false,
          "description": "Where a map's photograph sits on the sample: numbers, never pixels.\n\nThe image's centre is at (``centre_x_mm``, ``centre_y_mm``) in sample\ncoordinates (millimetres from the sample's centre, y up), one image pixel\nis ``mm_per_px`` wide, and the image is turned ``rotation_deg``\nanticlockwise as seen on the sample. ``sha256`` names the image the\nnumbers were fitted to, so they cannot end up beside another picture.\n``calibrated`` says the scale is real -- fitted to the outline or set from\ntwo points -- rather than the placeholder a fresh image starts with.",
          "properties": {
            "calibrated": {
              "default": false,
              "title": "Calibrated",
              "type": "boolean"
            },
            "calibration": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TwoPointCalibration"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "centre_x_mm": {
              "maximum": 100000.0,
              "minimum": -100000.0,
              "title": "Centre X Mm",
              "type": "number"
            },
            "centre_y_mm": {
              "maximum": 100000.0,
              "minimum": -100000.0,
              "title": "Centre Y Mm",
              "type": "number"
            },
            "image_height_px": {
              "maximum": 100000,
              "minimum": 1,
              "title": "Image Height Px",
              "type": "integer"
            },
            "image_width_px": {
              "maximum": 100000,
              "minimum": 1,
              "title": "Image Width Px",
              "type": "integer"
            },
            "mm_per_px": {
              "exclusiveMinimum": 0.0,
              "maximum": 1000.0,
              "title": "Mm Per Px",
              "type": "number"
            },
            "rotation_deg": {
              "maximum": 360.0,
              "minimum": -360.0,
              "title": "Rotation Deg",
              "type": "number"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "sha256",
            "image_width_px",
            "image_height_px",
            "mm_per_px",
            "centre_x_mm",
            "centre_y_mm",
            "rotation_deg"
          ],
          "title": "MapImageRegistration",
          "type": "object"
        },
        "MapSpot": {
          "additionalProperties": false,
          "description": "One spot of a map: the newest run with that index.",
          "properties": {
            "angle_deg": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Angle Deg"
            },
            "edge_clearance_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Edge Clearance S"
            },
            "file": {
              "title": "File",
              "type": "string"
            },
            "index": {
              "title": "Index",
              "type": "integer"
            },
            "label": {
              "title": "Label",
              "type": "string"
            },
            "relative_error": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Relative Error"
            },
            "relative_error_rows": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Relative Error Rows"
            },
            "sample": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Sample"
            },
            "started_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Started At"
            },
            "stats": {
              "$ref": "#/$defs/SpotStats"
            },
            "superseded": {
              "items": {
                "type": "string"
              },
              "title": "Superseded",
              "type": "array"
            },
            "x_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "X Mm"
            },
            "y_mm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Y Mm"
            }
          },
          "required": [
            "index",
            "label",
            "file",
            "stats"
          ],
          "title": "MapSpot",
          "type": "object"
        },
        "QuantityStats": {
          "additionalProperties": false,
          "description": "One derived quantity over a spot's samples (``session.spot_stats``).\n\n``n`` counts the finite values. Every other field is null on the wire when\nit does not exist: all of them with no finite value, ``sd`` and\n``rsd_pct`` with fewer than two.",
          "properties": {
            "mean": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mean"
            },
            "n": {
              "title": "N",
              "type": "integer"
            },
            "rsd_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rsd Pct"
            },
            "sd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Sd"
            },
            "u_inst": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Inst"
            },
            "u_stat": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Stat"
            },
            "u_total": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "U Total"
            }
          },
          "required": [
            "n"
          ],
          "title": "QuantityStats",
          "type": "object"
        },
        "SkippedRun": {
          "additionalProperties": false,
          "description": "A run that names this map but cannot stand for a spot.",
          "properties": {
            "file": {
              "title": "File",
              "type": "string"
            },
            "reason": {
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "file",
            "reason"
          ],
          "title": "SkippedRun",
          "type": "object"
        },
        "SpotStats": {
          "additionalProperties": false,
          "description": "The statistics block of a four-point run, as its file footer has it.\n\n``n`` samples entered the statistics; ``n_excluded`` were in compliance\nand left out, because they record a bound rather than a measurement.",
          "properties": {
            "end_reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End Reason"
            },
            "n": {
              "title": "N",
              "type": "integer"
            },
            "n_excluded": {
              "default": 0,
              "title": "N Excluded",
              "type": "integer"
            },
            "rho": {
              "$ref": "#/$defs/QuantityStats"
            },
            "rs": {
              "$ref": "#/$defs/QuantityStats"
            },
            "sigma": {
              "$ref": "#/$defs/QuantityStats"
            }
          },
          "required": [
            "n",
            "rs",
            "rho",
            "sigma"
          ],
          "title": "SpotStats",
          "type": "object"
        },
        "TwoPointCalibration": {
          "additionalProperties": false,
          "description": "Two image points a known distance apart: the scale of a photograph of\na sample that has no outline to fit. Pixel coordinates of the image as it\nwas taken, x to the right and y down, origin at its top-left corner.",
          "properties": {
            "distance_mm": {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "title": "Distance Mm",
              "type": "number"
            },
            "x1_px": {
              "maximum": 1000000.0,
              "minimum": -1000000.0,
              "title": "X1 Px",
              "type": "number"
            },
            "x2_px": {
              "maximum": 1000000.0,
              "minimum": -1000000.0,
              "title": "X2 Px",
              "type": "number"
            },
            "y1_px": {
              "maximum": 1000000.0,
              "minimum": -1000000.0,
              "title": "Y1 Px",
              "type": "number"
            },
            "y2_px": {
              "maximum": 1000000.0,
              "minimum": -1000000.0,
              "title": "Y2 Px",
              "type": "number"
            }
          },
          "required": [
            "x1_px",
            "y1_px",
            "x2_px",
            "y2_px",
            "distance_mm"
          ],
          "title": "TwoPointCalibration",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "A map: its spots in index order and the spread between them.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "map_id": {
          "title": "Map Id",
          "type": "string"
        },
        "rho": {
          "$ref": "#/$defs/InterSpotStats"
        },
        "rs": {
          "$ref": "#/$defs/InterSpotStats"
        },
        "sigma": {
          "$ref": "#/$defs/InterSpotStats"
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedRun"
          },
          "title": "Skipped",
          "type": "array"
        },
        "spots": {
          "items": {
            "$ref": "#/$defs/MapSpot"
          },
          "title": "Spots",
          "type": "array"
        }
      },
      "required": [
        "map_id",
        "rs",
        "rho",
        "sigma"
      ],
      "title": "SpotMap",
      "type": "object"
    }
  }
}
