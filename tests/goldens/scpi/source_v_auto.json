{
  "mode": "source_v",
  "measurement": {
    "vsource_voltage": 0.1,
    "vsource_current_compliance": 0.1,
    "vsource_current_range_auto": true,
    "vsource_duration_hours": 0.0
  },
  "writes": [
    "*RST",
    "*CLS",
    ":SYST:AZER:STAT ON",
    ":SENS:FUNC:CONC OFF",
    ":OUTP:SMOD HIMP",
    ":SYST:RSEN OFF",
    ":SENS:FUNC 'CURR:DC'",
    ":SOUR:FUNC VOLT",
    ":SOUR:VOLT:RANG 0.1",
    ":SOUR:VOLT 0.1",
    ":SENS:CURR:PROT 0.1",
    ":SENS:CURR:RANG:AUTO ON",
    ":SENS:CURR:NPLC 1.0",
    ":FORM:ELEM VOLT,CURR,STAT",
    ":TRIG:DEL 0",
    ":SOUR:DEL:AUTO ON",
    ":OUTP ON"
  ]
}
