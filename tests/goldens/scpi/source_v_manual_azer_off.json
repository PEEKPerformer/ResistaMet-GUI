{
  "mode": "source_v",
  "measurement": {
    "vsource_voltage": -1.0,
    "vsource_current_compliance": 0.01,
    "vsource_current_range_auto": false,
    "vsource_duration_hours": 0.0,
    "auto_zero": "off"
  },
  "writes": [
    "*RST",
    "*CLS",
    ":SYST:AZER:STAT OFF",
    ":SENS:FUNC:CONC OFF",
    ":OUTP:SMOD HIMP",
    ":SYST:RSEN OFF",
    ":SENS:FUNC 'CURR:DC'",
    ":SOUR:FUNC VOLT",
    ":SOUR:VOLT:RANG 1.0",
    ":SOUR:VOLT -1.0",
    ":SENS:CURR:PROT 0.01",
    ":SENS:CURR:RANG:AUTO OFF",
    ":SENS:CURR:RANG 0.01",
    ":SENS:CURR:NPLC 1.0",
    ":FORM:ELEM VOLT,CURR,STAT",
    ":TRIG:DEL 0",
    ":SOUR:DEL:AUTO ON",
    ":OUTP ON"
  ]
}
